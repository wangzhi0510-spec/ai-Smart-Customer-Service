# Application
APP_NAME=AI Smart Customer Service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=["http://localhost:5173"]

# MySQL
DATABASE_URL=mysql+pymysql://ai_customer_service:change_me@127.0.0.1:3306/ai_customer_service
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=ai_customer_service
MYSQL_USER=ai_customer_service
MYSQL_PASSWORD=

# Redis and Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Milvus
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_DATABASE=default
MILVUS_COLLECTION=customer_service_chunks

# LLM (DashScope OpenAI-compatible API)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local AI models
EMBEDDING_MODEL_PATH=
RERANKER_MODEL_PATH=
MODEL_DEVICE=auto

# RAG and document processing
DOCUMENT_STORAGE_PATH=backend/storage/documents
MAX_UPLOAD_SIZE_MB=20
PARENT_CHUNK_SIZE=1200
CHILD_CHUNK_SIZE=320
CHUNK_OVERLAP=64
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_FINAL_TOP_N=5
RRF_K=60
CONVERSATION_HISTORY_TURNS=5

# Business limits
DAILY_QUESTION_LIMIT=100
MAX_QUESTION_LENGTH=500

