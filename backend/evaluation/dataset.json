{
  "version": "1.0",
  "description": "首版中文客服知识库离线评测集，验证检索命中、来源正确性、fallback 和延迟。",
  "cases": [
    {
      "id": "product_trial",
      "question": "专业版免费试用多长时间？",
      "expected_source": "product-faq.md",
      "should_fallback": false,
      "keywords": ["专业版", "试用", "30"]
    },
    {
      "id": "refund_window",
      "question": "购买后多久可以申请退款？",
      "expected_source": "refund-policy.txt",
      "should_fallback": false,
      "keywords": ["退款", "七天"]
    },
    {
      "id": "reset_password",
      "question": "忘记密码后如何重置？",
      "expected_source": "account-guide.txt",
      "should_fallback": false,
      "keywords": ["忘记密码", "验证码"]
    },
    {
      "id": "unsupported_request",
      "question": "请评价今天的天气。",
      "expected_source": null,
      "should_fallback": true,
      "keywords": ["天气", "评价"]
    }
  ]
}